{
  "name": "skill-graph",
  "version": "1.1.0",
  "description": "Deterministic workflows your AI coding agent can't ignore. Wire the work as a graph of skills; a hook enforces order, tool permissions, joins, and loops at every step. Works with Claude Code and Codex.",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./adapters/claude-code": "./adapters/claude-code.mjs",
    "./adapters/codex": "./adapters/codex.mjs",
    "./adapters/core": "./adapters/core.mjs"
  },
  "bin": {
    "skill-graph": "bin/skill-graph.mjs",
    "skill-graph-claude": "adapters/claude-code.mjs",
    "skill-graph-codex": "adapters/codex.mjs",
    "skill-graph-mermaid": "bin/mermaid.mjs"
  },
  "files": ["src", "adapters", "bin", "docs", "examples", "README.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "test:e2e": "node e2e/run.mjs",
    "test:e2e:codex": "node e2e/codex-run.mjs"
  },
  "keywords": ["workflow", "state-machine", "agent", "dag", "claude-code", "codex", "governor", "ai-agents", "automation"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/vy-labs/skill-graph.git" },
  "engines": { "node": ">=22" },
  "sideEffects": false
}
